# Do not commit the real URL. A published ICS URL is an opaque, revocable credential.
# One calendar:
CALENDAR_ICS_URL=https://example.invalid/calendar.ics

# Or multiple calendars (takes precedence over CALENDAR_ICS_URL):
# CALENDARS_JSON=[{"id":"personal","url":"https://example.invalid/personal.ics"},{"id":"team","url":"https://example.invalid/team.ics"}]

# Optional. Requests are refused if the URL host is not included.
# CALENDAR_ALLOWED_HOSTS=outlook.office365.com

# Optional cache tuning.
# CALENDAR_CACHE_TTL_SECONDS=300

# Optional. IANA timezone used when a query does not specify one.
# CALENDAR_DEFAULT_TIMEZONE=America/New_York
