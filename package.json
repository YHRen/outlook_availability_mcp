{
  "name": "outlook-availability-mcp",
  "version": "0.1.0",
  "description": "A privacy-first MCP server that exposes calendar availability from ICS feeds.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YHRen/outlook_availability_mcp.git"
  },
  "type": "module",
  "bin": {
    "outlook-availability-mcp": "dist/index.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "calendar",
    "availability",
    "ics",
    "outlook"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "ical.js": "^2.2.1",
    "luxon": "^3.7.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/luxon": "^3.7.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
